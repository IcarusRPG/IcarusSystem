{
  "name": "icarus-rpg",
  "private": true,
  "description": "Sistema Icarus RPG para Foundry VTT (ferramentas de desenvolvimento)",
  "type": "module",
  "scripts": {
    "build:packs": "node tools/gerar-dados.mjs && node tools/build-packs.mjs",
    "extract:packs": "node tools/extract-packs.mjs",
    "test": "node --test tests/*.test.mjs",
    "gerar:dados": "node tools/gerar-dados.mjs",
    "build:tokens": "node tools/build-tokens.mjs",
    "build:icones-itens": "node tools/build-icones-itens.mjs",
    "build:icones-magias": "node tools/build-icones-magias.mjs",
    "magias:automacao": "node tools/extrair-automacao-magias.mjs",
    "build:icones-focos": "node tools/build-icones-focos.mjs"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "1.1.0"
  }
}
