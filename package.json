{
  "name": "icarus-rpg",
  "private": true,
  "description": "Sistema Icarus RPG para Foundry VTT (ferramentas de desenvolvimento)",
  "type": "module",
  "scripts": {
    "build:packs": "node tools/gerar-dados.mjs && node tools/build-packs.mjs",
