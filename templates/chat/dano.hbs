<div class="icarus-rolagem icarus-dano{{#if critico}} critico{{/if}}">
  <div class="arma-cab">
    <img src="{{arma.img}}" alt="" width="36" height="36">
    <div>
      <h3 class="rolagem-nome">{{arma.nome}}</h3>
      <div class="rolagem-tipo">{{#if critico}}{{localize "ICARUS.Armas.Card.DanoCritico"}} (×{{mult}}){{else}}{{localize "ICARUS.Armas.Card.Dano"}}{{/if}}{{#if extra}} · {{extra}}{{/if}}</div>
    </div>
  </div>
  <div class="rolagem-dados">
    <span class="rolagem-formula">{{texto}}</span>
    <span class="rolagem-total">{{total}}</span>
  </div>
  {{#if tipos}}<div class="linha-municao">{{localize "ICARUS.Armas.TipoDano"}}: {{tipos}}</div>{{/if}}
  {{#if botoes}}
  <div class="rolagem-botoes">
    {{#if perda}}
    <button type="button" data-icarus-aplicar="perda">{{localize "ICARUS.Dano.AplicarPerda"}}</button>
    {{else}}
    <button type="button" data-icarus-aplicar="dano">{{localize "ICARUS.Dano.Aplicar"}}</button>
    <button type="button" data-icarus-aplicar="metade">{{localize "ICARUS.Dano.Metade"}}</button>
    <button type="button" data-icarus-aplicar="dobro">{{localize "ICARUS.Dano.Dobro"}}</button>
    <button type="button" data-icarus-aplicar="perda">{{localize "ICARUS.Dano.AplicarPerda"}}</button>
    {{/if}}
  </div>
  <div class="linha-municao">{{localize "ICARUS.Dano.DicaSelecionar"}}</div>
  {{/if}}
</div>
