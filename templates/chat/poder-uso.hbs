<div class="icarus-rolagem icarus-poder">
  <div class="arma-cab">
    <img src="{{img}}" alt="" width="36" height="36">
    <div>
      <h3 class="rolagem-nome">{{nome}}</h3>
      <div class="rolagem-tipo">{{#if acao}}{{acao}}{{/if}}{{#if pm}} · <span class="custo">{{pm}} PM</span>{{/if}}{{#if reacao}} · {{localize "ICARUS.Reacao.Gasta"}}{{/if}}</div>
    </div>
  </div>
  {{#if forcado}}<div class="linha-aviso">{{localize "ICARUS.Reacao.Forcada"}}</div>{{/if}}
  <div class="poder-descricao">{{{descricao}}}</div>
</div>
