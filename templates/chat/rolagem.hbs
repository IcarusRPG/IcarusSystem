<div class="icarus-rolagem{{#if critico}} critico{{/if}}{{#if falha}} falha{{/if}}{{#if falhaAutomatica}} falha{{/if}}">
  <div class="rolagem-tipo">{{tipoRotulo}}</div>
  <h3 class="rolagem-nome">{{rotulo}}</h3>
  {{#if falhaAutomatica}}
  <div class="rolagem-selo">{{localize "ICARUS.Condicoes.FalhaAutomatica"}}</div>
  {{else}}
  <div class="rolagem-dados">
    {{> "systems/icarus-rpg/templates/chat/partes-d20.hbs"}}
    <span class="rolagem-formula">{{formula}}</span>
    <span class="rolagem-total">{{total}}</span>
  </div>
  {{#if modoRotulo}}<div class="rolagem-modo">{{modoRotulo}}</div>{{/if}}
  {{#each extras}}<div class="linha-extra">{{this}}</div>{{/each}}
  {{#if quebraGazuas}}<div class="linha-aviso">{{localize "ICARUS.ItensComuns.GazuasQuebram"}}</div>
  <button type="button" class="btn peq" data-action="quebrar-gazuas">{{localize "ICARUS.ItensComuns.QuebrarGazuas"}}</button>{{/if}}
  {{#if minimoAplicado}}<div class="linha-aviso">{{minimoAplicado}}</div>{{/if}}
  {{#if critico}}<div class="rolagem-selo">{{localize "ICARUS.Rolagem.Critico"}}</div>{{/if}}
  {{#if falha}}<div class="rolagem-selo">{{localize "ICARUS.Rolagem.Falha"}}</div>{{/if}}
  {{/if}}
</div>
