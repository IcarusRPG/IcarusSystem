<form class="{{cssClass}} ficha-icarus ficha-item" autocomplete="off">
  <header class="item-cab">
    <img src="{{item.img}}" alt="" data-edit="img" width="64" height="64">
    <input class="nome" type="text" name="name" value="{{item.name}}" aria-label="{{localize 'ICARUS.Item.Nome'}}">
  </header>
  <div class="item-campos">
    <label class="f"><span class="rot">{{localize "ICARUS.Equipamento.Tipo"}}</span>
      <select class="campo" name="system.tipo">{{selectOptions opcoesTipo selected=source.tipo localize=true}}</select></label>
    <label class="f"><span class="rot">{{localize "ICARUS.Equipamento.Quantidade"}}</span>
      <input class="campo" type="number" name="system.quantidade" value="{{source.quantidade}}" min="0" step="1"></label>
    <label class="f"><span class="rot">{{localize "ICARUS.Inventario.PrecoReais"}}</span>
      <input class="campo" type="number" name="precoReais" value="{{preco.reais}}" min="0" step="0.01" title="{{preco.ouro}}"></label>
    <label class="f"><span class="rot">{{localize "ICARUS.Inventario.Espacos"}}</span>
      <input class="campo" type="number" name="system.espacos" value="{{source.espacos}}" min="0" step="0.5"></label>
    {{#if equipavel}}
    <label class="f"><span class="rot">{{localize "ICARUS.Equipamento.BonusDefesa"}}</span>
      <input class="campo" type="number" name="system.bonusDefesa" value="{{source.bonusDefesa}}" step="1"></label>
    <label class="f"><span class="rot">{{localize "ICARUS.Armaduras.Categoria"}}</span>
      <select class="campo" name="system.categoria">{{selectOptions opcoesCategoriaArmadura selected=source.categoria localize=true}}</select></label>
    <label class="f"><span class="rot">{{localize "ICARUS.Armaduras.Penalidade"}}</span>
      <input class="campo" type="number" name="system.penalidade" value="{{source.penalidade}}" min="0" step="1"></label>
    <label class="chk"><input type="checkbox" name="system.equipado" {{checked source.equipado}}> {{localize "ICARUS.Inventario.Equipado"}}</label>
    <label class="chk"><input type="checkbox" name="system.acoplado" {{checked source.acoplado}}> {{localize "ICARUS.Armaduras.Acoplado"}}</label>
    {{/if}}
  </div>
  {{#if itemComum}}
  <div class="item-campos item-comum">
    <label class="chk"><input type="checkbox" name="system.vestimenta" {{checked source.vestimenta}}> {{localize "ICARUS.ItensComuns.Vestimenta"}}</label>
    {{#if source.vestimenta}}<label class="chk"><input type="checkbox" name="system.vestido" {{checked source.vestido}}> {{localize "ICARUS.ItensComuns.Vestido"}}</label>{{/if}}
    <label class="chk"><input type="checkbox" name="system.valeEnquantoPossui" {{checked source.valeEnquantoPossui}}> {{localize "ICARUS.ItensComuns.ValeEnquantoPossui"}}</label>
    <label class="chk"><input type="checkbox" name="system.semVenda" {{checked source.semVenda}}> {{localize "ICARUS.ItensComuns.SemVenda"}}</label>
    <label class="f"><span class="rot">{{localize "ICARUS.ItensComuns.PrecoVenda"}}</span>
      <input class="campo" type="number" name="precoVendaReais" value="{{itemComum.precoVendaReais}}" min="0" step="0.01"></label>
    <label class="f"><span class="rot">{{localize "ICARUS.ItensComuns.UsosAtual"}}</span>
      <input class="campo" type="number" name="system.usos.atual" value="{{source.usos.atual}}" min="0" step="1"></label>
    <label class="f"><span class="rot">{{localize "ICARUS.ItensComuns.UsosMax"}}</span>
      <input class="campo" type="number" name="system.usos.max" value="{{source.usos.max}}" min="0" step="1"></label>
    {{#if itemComum.opcoesBonus}}
    <label class="f"><span class="rot">{{localize "ICARUS.ItensComuns.EscolhaBonus"}}</span>
      <select class="campo" name="flags.icarus-rpg.escolhaBonus">{{selectOptions itemComum.opcoesBonus selected=itemComum.escolhaBonus}}</select></label>
    {{/if}}
  </div>
  {{#if itemComum.bonus.length}}
  <ul class="bonus-lista">{{#each itemComum.bonus}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}
  {{/if}}
  {{#if provisorio}}<p class="dica">{{localize "ICARUS.Armaduras.Provisorio"}}: {{provisorio}}</p>{{/if}}
  <div class="painel item-desc">
    <h3 class="titulo-painel">{{localize "ICARUS.Item.Descricao"}}</h3>
    {{editor descricaoHTML target="system.descricao" button=true editable=editable engine="prosemirror"}}
  </div>
</form>
