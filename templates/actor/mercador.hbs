<div class="ficha-icarus ficha-mercador-corpo">
  <header class="fm-cabecalho">
    <img class="fm-retrato" src="{{img}}" alt="{{nome}}" {{#if editavel}}data-action="imagem"{{/if}}>
    <div class="fm-identidade">
      <input class="fm-nome" type="text" name="name" value="{{nome}}" aria-label="{{localize "ICARUS.Mercador.Nome"}}">
      <p class="fm-linha">{{localize "TYPES.Actor.mercador"}}
        · <span class="{{#if s.loja.aberta}}fm-aberta{{else}}fm-fechada{{/if}}">{{#if s.loja.aberta}}{{localize "ICARUS.Mercador.LojaAberta"}}{{else}}{{localize "ICARUS.Mercador.LojaFechada"}}{{/if}}</span></p>
      <div class="fm-botoes">
        <button type="button" class="btn" data-action="alternarLoja"><i class="fa-solid fa-store"></i> {{#if s.loja.aberta}}{{localize "ICARUS.Mercador.FecharLoja"}}{{else}}{{localize "ICARUS.Mercador.AbrirLoja"}}{{/if}}</button>
        <button type="button" class="btn" data-action="verComoJogador"><i class="fa-solid fa-eye"></i> {{localize "ICARUS.Mercador.VerComoJogador"}}</button>
      </div>
    </div>
  </header>

  <nav class="fm-abas">
    <a class="{{#if (eq aba "ficha")}}ativa{{/if}}" data-action="aba" data-aba="ficha">{{localize "ICARUS.Mercador.Abas.ficha"}}</a>
    <a class="{{#if (eq aba "loja")}}ativa{{/if}}" data-action="aba" data-aba="loja">{{localize "ICARUS.Mercador.Abas.loja"}}</a>
    <a class="{{#if (eq aba "notas")}}ativa{{/if}}" data-action="aba" data-aba="notas">{{localize "ICARUS.Mercador.Abas.notas"}}</a>
  </nav>

  <div class="fm-corpo">
    {{#if (eq aba "ficha")}}
    <section class="fm-bloco fm-numeros">
      <label>{{localize "ICARUS.Nivel.Rotulo"}} <input type="number" name="system.nivel" value="{{s.nivel}}" min="0" step="1"></label>
      <label>{{localize "ICARUS.Defesa.Rotulo"}} <input type="number" name="system.defesa" value="{{s.defesa}}" step="1"></label>
      <label>PV <input type="number" name="system.pv.value" value="{{s.pv.value}}" min="0" step="1"> / <input type="number" name="system.pv.max" value="{{s.pv.max}}" min="0" step="1"></label>
      <label>PM <input type="number" name="system.pm.value" value="{{s.pm.value}}" min="0" step="1"> / <input type="number" name="system.pm.max" value="{{s.pm.max}}" min="0" step="1"></label>
    </section>
    <section class="fm-bloco fm-atributos">
      {{#each atributos}}<label>{{rotulo}} <input type="number" name="system.atributos.{{chave}}" value="{{valor}}" step="1"></label>{{/each}}
    </section>
    <section class="fm-bloco">
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Pericias"}} <a data-action="adicionarLinha" data-lista="pericias"><i class="fa-solid fa-plus"></i></a></h3>
      {{#each pericias}}
      <div class="fm-linha-lista">
        <input type="text" value="{{nome}}" data-lista="pericias" data-indice="{{i}}" data-campo="nome" placeholder="{{localize "ICARUS.Mercador.Pericia"}}">
        <input type="number" class="fm-curto" value="{{bonus}}" data-lista="pericias" data-indice="{{i}}" data-campo="bonus" step="1">
        <a data-action="removerLinha" data-lista="pericias" data-indice="{{i}}"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{/each}}
    </section>
    <section class="fm-bloco">
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Habilidades"}} <a data-action="adicionarLinha" data-lista="habilidades"><i class="fa-solid fa-plus"></i></a></h3>
      {{#each habilidades}}
      <div class="fm-linha-lista fm-habilidade">
        <input type="text" value="{{nome}}" data-lista="habilidades" data-indice="{{i}}" data-campo="nome" placeholder="{{localize "ICARUS.Mercador.Habilidade"}}">
        <a data-action="removerLinha" data-lista="habilidades" data-indice="{{i}}"><i class="fa-solid fa-trash"></i></a>
        <textarea data-lista="habilidades" data-indice="{{i}}" data-campo="descricao" rows="2">{{descricao}}</textarea>
      </div>
      {{/each}}
    </section>
    <section class="fm-bloco">
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Equipamento"}}</h3>
      {{#each equipamento}}
      <div class="fm-linha-lista" data-item-id="{{id}}">
        <img src="{{img}}" alt="" width="24" height="24"><a data-action="abrirItem">{{nome}}</a>
        {{#if temEquipado}}<label class="chk"><input type="checkbox" data-equipado {{#if equipado}}checked{{/if}}> {{localize "ICARUS.Mercador.Equipado"}}</label>{{/if}}
        <a data-action="removerItem"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{else}}<p class="dica">{{localize "ICARUS.Mercador.ArrasteEquipamento"}}</p>{{/each}}
    </section>
    <section class="fm-bloco">
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Magias"}}</h3>
      {{#each magias}}<div class="fm-linha-lista" data-item-id="{{id}}"><img src="{{img}}" alt="" width="24" height="24"><a data-action="abrirItem">{{nome}}</a><a data-action="removerItem"><i class="fa-solid fa-trash"></i></a></div>
      {{else}}<p class="dica">—</p>{{/each}}
    </section>
    {{/if}}

    {{#if (eq aba "loja")}}
    <section class="fm-bloco fm-loja-config">
      <label class="fm-largo">{{localize "ICARUS.Mercador.Saudacao"}} <input type="text" name="system.loja.saudacao" value="{{s.loja.saudacao}}"></label>
      <label class="fm-largo">{{localize "ICARUS.Mercador.Despedida"}} <input type="text" name="system.loja.despedida" value="{{s.loja.despedida}}"></label>
      <label>{{localize "ICARUS.Mercador.Multiplicador"}} <input type="number" name="system.loja.multiplicadorPreco" value="{{s.loja.multiplicadorPreco}}" min="0.01" step="0.05"></label>
      <label class="chk"><input type="checkbox" name="system.caixaInfinita" {{#if s.caixaInfinita}}checked{{/if}}> {{localize "ICARUS.Mercador.CaixaInfinita"}}</label>
      {{#unless s.caixaInfinita}}
      <div class="fm-caixa">{{localize "ICARUS.Mercador.Caixa"}} ({{caixaTotal}}):
        <label>{{localize "ICARUS.Moedas.OuroReal"}} <input type="number" name="system.caixa.ouroReal" value="{{s.caixa.ouroReal}}" min="0" step="1"></label>
        <label>{{localize "ICARUS.Moedas.Real"}} <input type="number" name="system.caixa.real" value="{{s.caixa.real}}" min="0" step="1"></label>
        <label>{{localize "ICARUS.Moedas.Centavo"}} <input type="number" name="system.caixa.centavo" value="{{s.caixa.centavo}}" min="0" step="1"></label>
      </div>
      {{/unless}}
      <label class="chk"><input type="checkbox" name="system.loja.compra.ativo" {{#if s.loja.compra.ativo}}checked{{/if}}> {{localize "ICARUS.Mercador.CompraAtiva"}}</label>
      {{#if s.loja.compra.ativo}}<label>{{localize "ICARUS.Mercador.Percentual"}} <input type="number" name="system.loja.compra.percentual" value="{{s.loja.compra.percentual}}" min="0" max="1" step="0.05"></label>{{/if}}
    </section>
    <section class="fm-bloco">
      <p class="dica">{{localize "ICARUS.Mercador.ArrasteEstoque"}}</p>
      <button type="button" class="btn" data-action="criarItem"><i class="fa-solid fa-plus"></i> {{localize "ICARUS.Mercador.CriarItem"}}</button>
      <table class="fm-estoque">
        <thead><tr><th></th><th>{{localize "ICARUS.Mercador.Item"}}</th><th>{{localize "ICARUS.Mercador.Quantidade"}}</th>
          <th>{{localize "ICARUS.Mercador.PrecoBase"}}</th><th>{{localize "ICARUS.Mercador.PrecoFinal"}}</th><th>{{localize "ICARUS.Mercador.Oculto"}}</th>
          <th>{{localize "ICARUS.Mercador.LiberaCom"}}</th><th data-tooltip="{{localize "ICARUS.Mercador.CdRouboItemDica"}}">{{localize "ICARUS.Mercador.CdRouboItem"}}</th><th></th></tr></thead>
        <tbody>
          {{#each estoque}}
          <tr data-item-id="{{id}}" class="{{#if oculto}}oculto{{/if}}">
            <td><img src="{{img}}" alt="" width="28" height="28" data-action="abrirItem"></td>
            <td><input type="text" class="fm-nome-item" value="{{nome}}" data-loja-campo="nome">{{#if semVenda}} <span class="aviso" data-tooltip="{{localize "ICARUS.Mercador.SemVendaDica"}}">({{localize "ICARUS.Mercador.SemVenda"}})</span>{{/if}}</td>
            <td><input type="number" class="fm-curto" value="{{quantidade}}" min="0" step="1" data-loja-campo="quantidade"></td>
            <td><input type="number" class="fm-medio" value="{{precoBase}}" min="0" step="0.01" placeholder="{{precoItem}}" data-loja-campo="precoBase" data-tooltip="{{localize "ICARUS.Mercador.PrecoBaseDica"}}"></td>
            <td title="{{dicaOuro}}">{{precoFinal}}</td>
            <td><input type="checkbox" data-loja-campo="oculto" {{#if oculto}}checked{{/if}}></td>
            <td><select data-loja-campo="liberaCom" {{#unless oculto}}disabled{{/unless}}>{{#each libera}}<option value="{{valor}}" {{#if selecionado}}selected{{/if}}>{{rotulo}}</option>{{/each}}</select></td>
            <td><input type="number" class="fm-curto" value="{{cdRoubo}}" min="0" step="1" placeholder="{{../s.loja.roubo.cd}}" data-loja-campo="cdRoubo"></td>
            <td><a data-action="removerItem"><i class="fa-solid fa-trash"></i></a></td>
          </tr>
          {{else}}<tr><td colspan="9" class="dica">{{localize "ICARUS.Mercador.EstoqueVazio"}}</td></tr>{{/each}}
        </tbody>
      </table>
    </section>

    <section class="fm-bloco fm-barganha">
      <h3 class="fm-titulo"><i class="fa-solid fa-dice-d20 fm-d20"></i> {{localize "ICARUS.Mercador.Barganha"}}{{#if barganha.efeitos}} <span class="fm-efeitos">{{barganha.efeitos}}</span>{{/if}}</h3>
      {{#if barganha.guardas}}
      <p class="aviso"><i class="fa-solid fa-shield-halved"></i> {{localize "ICARUS.Loja.Barganha.Guardas"}}
        <button type="button" class="btn" data-action="acalmarGuardas">{{localize "ICARUS.Mercador.AcalmarGuardas"}}</button></p>
      {{/if}}
      <table class="fm-estoque">
        <thead><tr><th></th><th>{{localize "ICARUS.Mercador.Ativo"}}</th><th>CD</th><th>{{localize "ICARUS.Mercador.Estado"}}</th></tr></thead>
        <tbody>
          {{#each barganha.testes}}
          <tr><td>{{nome}}</td>
            <td><input type="checkbox" name="system.loja.barganha.testes.{{chave}}.ativo" {{#if ativo}}checked{{/if}}></td>
            <td><input type="number" class="fm-curto" name="system.loja.barganha.testes.{{chave}}.cd" value="{{cd}}" min="0" step="1"></td>
            <td>{{estado}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      <div class="fm-loja-config">
        <label>{{localize "ICARUS.Mercador.DescontoSucesso"}} <input type="number" name="system.loja.barganha.descontoSucesso" value="{{s.loja.barganha.descontoSucesso}}" min="0" max="100" step="1">%</label>
        <label>{{localize "ICARUS.Mercador.DescontoCritico"}} <input type="number" name="system.loja.barganha.descontoCritico" value="{{s.loja.barganha.descontoCritico}}" min="0" max="100" step="1">%</label>
        <label>{{localize "ICARUS.Mercador.Acrescimo"}} <input type="number" name="system.loja.barganha.acrescimo" value="{{s.loja.barganha.acrescimo}}" min="0" step="1">%</label>
        <label class="chk"><input type="checkbox" name="system.loja.barganha.mostrarCD" {{#if s.loja.barganha.mostrarCD}}checked{{/if}}> {{localize "ICARUS.Mercador.MostrarCD"}}</label>
        <label class="chk"><input type="checkbox" name="system.loja.barganha.falasNoChat" {{#if s.loja.barganha.falasNoChat}}checked{{/if}}> {{localize "ICARUS.Mercador.FalasNoChat"}}</label>
      </div>
      <div class="fm-loja-config">
        <span>{{localize "ICARUS.Mercador.GuardasTitulo"}}</span>
        <label class="chk"><input type="checkbox" name="system.loja.barganha.guardas.fecharLoja" {{#if s.loja.barganha.guardas.fecharLoja}}checked{{/if}}> {{localize "ICARUS.Mercador.FecharLojaGuardas"}}</label>
        <label class="chk"><input type="checkbox" name="system.loja.barganha.guardas.avisarMestre" {{#if s.loja.barganha.guardas.avisarMestre}}checked{{/if}}> {{localize "ICARUS.Mercador.AvisarMestre"}}</label>
        <label class="fm-largo">{{localize "ICARUS.Mercador.NotaGuardas"}} <input type="text" name="system.loja.barganha.guardas.nota" value="{{s.loja.barganha.guardas.nota}}" placeholder="{{localize "ICARUS.Mercador.NotaGuardasExemplo"}}"></label>
      </div>
      <div class="fm-botoes">
        <button type="button" class="btn" data-action="reiniciarBarganhas" {{#unless barganha.algumFeito}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> {{localize "ICARUS.Mercador.ReiniciarBarganhas"}}</button>
        <button type="button" class="btn" data-action="restaurarFalas"><i class="fa-solid fa-comment-dots"></i> {{localize "ICARUS.Mercador.RestaurarFalas"}}</button>
      </div>
      <h3 class="fm-titulo"><i class="fa-solid fa-hand fm-d20"></i> {{localize "ICARUS.Mercador.RouboTitulo"}}</h3>
      <div class="fm-loja-config">
        <label class="chk"><input type="checkbox" name="system.loja.roubo.permitir" {{#if s.loja.roubo.permitir}}checked{{/if}}> {{localize "ICARUS.Mercador.PermitirRoubar"}}</label>
        <label>{{localize "ICARUS.Mercador.CdRoubo"}} <input type="number" name="system.loja.roubo.cd" value="{{s.loja.roubo.cd}}" min="0" step="1"></label>
        <label>{{localize "ICARUS.Mercador.Tentativas"}} <input type="number" name="system.loja.roubo.tentativas" value="{{s.loja.roubo.tentativas}}" min="1" step="1"></label>
        <span class="dica">{{localize "ICARUS.Mercador.RouboGuardasDica"}}</span>
      </div>
      {{#if roubo.tentativas.length}}
      <ul class="fm-estado">
        {{#each roubo.tentativas}}<li>{{nome}}: {{n}} {{localize "ICARUS.Mercador.TentativasSemDinheiro"}} <a data-action="zerarTentativas" data-usuario="{{usuarioId}}"><i class="fa-solid fa-rotate-left"></i> {{localize "ICARUS.Mercador.Zerar"}}</a></li>{{/each}}
      </ul>
      {{/if}}
      {{#if roubo.roubos.length}}
      <ul class="fm-estado">{{#each roubo.roubos}}<li>{{texto}}</li>{{/each}}</ul>
      {{/if}}
      <details class="fm-falas">
        <summary>{{localize "ICARUS.Mercador.Falas"}}: {{localize "ICARUS.Mercador.RouboTitulo"}}</summary>
        <label class="fm-largo fm-fala">{{localize "ICARUS.Mercador.AvisoSemDinheiro"}} <textarea name="system.loja.roubo.aviso" rows="2">{{s.loja.roubo.aviso}}</textarea></label>
        <label class="fm-largo fm-fala">{{localize "ICARUS.Mercador.FalasGuardasSemDinheiro"}} <textarea name="system.loja.roubo.falasGuardas" rows="3">{{s.loja.roubo.falasGuardas}}</textarea></label>
        <label class="fm-largo fm-fala">{{localize "ICARUS.Mercador.FalasFlagrante"}} <textarea name="system.loja.roubo.falasFlagrante" rows="3">{{s.loja.roubo.falasFlagrante}}</textarea></label>
        <label class="fm-largo fm-fala">{{localize "ICARUS.Mercador.MensagemRoubo"}} <textarea name="system.loja.roubo.sucesso" rows="2">{{s.loja.roubo.sucesso}}</textarea></label>
      </details>
      <p class="dica">{{localize "ICARUS.Mercador.FalasDica"}}</p>
      {{#each barganha.testes}}
      <details class="fm-falas">
        <summary>{{localize "ICARUS.Mercador.Falas"}}: {{nome}}</summary>
        {{#each falas}}
        <label class="fm-largo fm-fala">{{rotulo}}
          <textarea name="system.loja.barganha.falas.{{../chave}}.{{chave}}" rows="3">{{texto}}</textarea></label>
        {{/each}}
      </details>
      {{/each}}
    </section>
    {{/if}}

    {{#if (eq aba "notas")}}
    <section class="fm-bloco">
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Descricao"}}</h3>
      <textarea name="system.descricao" rows="5">{{s.descricao}}</textarea>
      <h3 class="fm-titulo">{{localize "ICARUS.Mercador.Notas"}}</h3>
      <textarea name="system.notas" rows="10">{{notas}}</textarea>
    </section>
    {{/if}}
  </div>
</div>
