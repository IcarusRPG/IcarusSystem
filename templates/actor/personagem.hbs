<form class="{{cssClass}} ficha-icarus" autocomplete="off">
  {{> "systems/icarus-rpg/templates/actor/parts/cabecalho.hbs"}}
  {{> "systems/icarus-rpg/templates/actor/parts/recursos.hbs"}}

  <nav class="abas">
    <div class="abas-lista" role="tablist">
      <button type="button" class="item aba" data-tab="caracteristicas" role="tab">{{localize "ICARUS.Abas.caracteristicas"}}</button>
      <button type="button" class="item aba" data-tab="inventario" role="tab">{{localize "ICARUS.Abas.inventario"}}</button>
      <button type="button" class="item aba" data-tab="poderes" role="tab">{{localize "ICARUS.Abas.poderes"}}</button>
      <button type="button" class="item aba" data-tab="diario" role="tab">{{localize "ICARUS.Abas.diario"}}</button>
      <button type="button" class="item aba" data-tab="efeitos" role="tab">{{localize "ICARUS.Abas.efeitos"}}</button>
    </div>
    {{#if editable}}
    <button type="button" class="btn btn-nivel" data-action="abrir-nivel" aria-label="{{localize 'ICARUS.NivelDialogo.Titulo'}}">
      <i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "ICARUS.Nivel.Botao"}}
    </button>
    {{/if}}
  </nav>

  <section class="corpo">
    <div class="tab" data-tab="caracteristicas">{{> "systems/icarus-rpg/templates/actor/parts/caracteristicas.hbs"}}</div>
    <div class="tab" data-tab="inventario">{{> "systems/icarus-rpg/templates/actor/parts/inventario.hbs"}}</div>
    <div class="tab" data-tab="poderes">{{> "systems/icarus-rpg/templates/actor/parts/poderes.hbs"}}</div>
    <div class="tab" data-tab="diario">{{> "systems/icarus-rpg/templates/actor/parts/diario.hbs"}}</div>
    <div class="tab" data-tab="efeitos">{{> "systems/icarus-rpg/templates/actor/parts/efeitos.hbs"}}</div>
  </section>

  <footer class="rodape">
    <span>{{localize "ICARUS.Rodape.Rolar"}}</span>
    <span>{{localize "ICARUS.Treino.Legenda"}}</span>
  </footer>
</form>
