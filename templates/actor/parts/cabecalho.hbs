<header class="cab">
  <div class="retrato" title="{{localize 'ICARUS.Retrato.Dica'}}">
    <span class="moldura hex"></span>
    <span class="miolo hex">
      <img src="{{actor.img}}" alt="{{actor.name}}" data-edit="img"{{#if editable}} tabindex="0"{{/if}}>
    </span>
  </div>

  <div class="cab-meio">
    <input class="nome" type="text" name="name" value="{{actor.name}}" aria-label="{{localize 'ICARUS.Identidade.Nome'}}" placeholder="{{localize 'ICARUS.Identidade.Nome'}}">
    <div class="identidade">
      {{!-- Raça: combobox; a troca aplica atributos raciais, poderes e efeitos (module/racas.mjs) --}}
      <div class="campo-raca">
        <label class="rot" for="{{actor.id}}-raca">{{localize "ICARUS.Identidade.raca"}}</label>
        <div class="raca-linha">
          <span class="raca-icone" aria-hidden="true">
            <span class="moldura hex"></span>
            <span class="miolo hex"><img src="{{raca.icone}}" alt="" onerror="this.onerror=null;this.src='{{iconePadrao}}'"></span>
          </span>
          <select id="{{actor.id}}-raca" class="campo sel-raca" aria-describedby="{{actor.id}}-raca-sig">
            {{#each raca.opcoes}}<option value="{{valor}}"{{#if selecionado}} selected{{/if}}>{{rotulo}}</option>{{/each}}
          </select>
          {{#if raca.id}}{{#if editable}}
          <button type="button" class="btn icone" data-action="raca-reaplicar" title="{{localize 'ICARUS.Racas.Reaplicar'}}" aria-label="{{localize 'ICARUS.Racas.Reaplicar'}}"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
          {{/if}}{{/if}}
        </div>
        <span class="raca-significado" id="{{actor.id}}-raca-sig">{{raca.significado}}</span>
      </div>
      {{!-- Classe: escolher do compêndio preenche PV/PM, perícias e habilidades (module/classes.mjs) --}}
      <div class="campo-classe">
        <label class="rot" for="{{actor.id}}-classe">{{localize "ICARUS.Identidade.classe"}}</label>
        <div class="classe-linha">
          {{#if classe.icone}}<img class="classe-icone" src="{{classe.icone}}" alt="" width="24" height="24" onerror="this.onerror=null;this.src='{{iconePadrao}}'">{{/if}}
          <select id="{{actor.id}}-classe" class="campo sel-classe"{{#if classe.papel}} data-tooltip="{{classe.papel}}"{{/if}}>
            {{#each classe.opcoes}}<option value="{{valor}}"{{#if selecionado}} selected{{/if}}>{{rotulo}}</option>{{/each}}
          </select>
        </div>
      </div>

      {{!-- Origem: combobox; a troca concede perícia, poder e itens (module/origens.mjs) --}}
      <div class="campo-origem">
        <label class="rot" for="{{actor.id}}-origem">{{localize "ICARUS.Identidade.origem"}}</label>
        <div class="origem-linha">
          <select id="{{actor.id}}-origem" class="campo sel-origem" aria-describedby="{{actor.id}}-origem-texto">
            {{#each origem.opcoes}}<option value="{{valor}}"{{#if selecionado}} selected{{/if}}>{{rotulo}}</option>{{/each}}
          </select>
          {{#if origem.id}}{{#if editable}}
          <button type="button" class="btn icone" data-action="origem-reaplicar" title="{{localize 'ICARUS.Origens.Reaplicar'}}" aria-label="{{localize 'ICARUS.Origens.Reaplicar'}}"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
          {{/if}}{{/if}}
          {{#if origem.desfazer}}{{#if editable}}
          <button type="button" class="btn icone" data-action="origem-desfazer" title="{{localize 'ICARUS.Origens.Desfazer'}}" aria-label="{{localize 'ICARUS.Origens.Desfazer'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
          {{/if}}{{/if}}
        </div>
        <span class="origem-texto" id="{{actor.id}}-origem-texto" title="{{origem.texto}}">{{origem.texto}}</span>
      </div>

      {{#each identidade}}
      <label>
        <span class="rot">{{rotulo}}</span>
        <input class="campo" type="text" name="system.identidade.{{chave}}" value="{{valor}}" placeholder="{{placeholder}}">
      </label>
      {{/each}}

      {{!-- Divindade: combobox em árvore (Nenhum(a) · Alfars [+] · Baldurs [+]), module/panteao.mjs --}}
      <div class="campo-divindade">
        <span class="rot" id="{{actor.id}}-div-rot">{{localize "ICARUS.Identidade.divindade"}}</span>
        <div class="combo-divindade">
          <button type="button" class="campo combo-botao" aria-haspopup="tree" aria-expanded="false" aria-labelledby="{{actor.id}}-div-rot {{actor.id}}-div-valor"{{#unless editable}} disabled{{/unless}}>
            {{#if divindade.simbolo}}<img src="{{divindade.simbolo}}" alt="" width="22" height="22">{{/if}}
            <span id="{{actor.id}}-div-valor" class="combo-valor">{{divindade.rotulo}}</span>
            <i class="fa-solid fa-caret-down" aria-hidden="true"></i>
          </button>
          <ul class="arvore-divindade" role="tree" aria-labelledby="{{actor.id}}-div-rot" hidden>
            <li role="treeitem" class="folha" data-valor="" tabindex="-1" aria-selected="{{#unless divindade.id}}{{#unless divindade.outra}}true{{else}}false{{/unless}}{{else}}false{{/unless}}">{{localize "ICARUS.Devocao.Nenhuma"}}</li>
            {{#each divindade.grupos}}
            <li role="treeitem" class="grupo" data-grupo="{{nome}}" aria-expanded="false" tabindex="-1">
              <span class="grupo-linha"><span class="expandir" aria-hidden="true">[+]</span> {{nome}}</span>
              <ul role="group" hidden>
                {{#each itens}}
                <li role="treeitem" class="folha" data-valor="{{id}}" tabindex="-1" title="{{titulo}}" aria-selected="{{#if selecionado}}true{{else}}false{{/if}}">
                  <img src="{{simbolo}}" alt="" width="22" height="22"> {{nome}}
                </li>
                {{/each}}
              </ul>
            </li>
            {{/each}}
            {{#if divindade.outra}}<li role="treeitem" class="folha" data-valor="{{divindade.outra}}" tabindex="-1" aria-selected="true">{{localize "ICARUS.Devocao.Outra"}}: {{divindade.outra}}</li>{{/if}}
          </ul>
        </div>
        {{#if divindade.id}}
        <details class="painel-divindade">
          <summary>{{localize "ICARUS.Devocao.DogmasEPoderes"}}</summary>
          <div class="painel-divindade-corpo">
            <p class="dica">{{divindade.titulo}}</p>
            <h4>{{localize "ICARUS.Devocao.Dogmas"}}</h4>
            <p>{{divindade.dogma}}</p>
            <h4>{{localize "ICARUS.Devocao.PoderesConcedidos"}}</h4>
            <ul>{{#each divindade.poderes}}<li><b>{{nome}}</b>{{#if meta}} <span class="dica">({{meta}})</span>{{/if}}{{#if possui}} ✓{{/if}}</li>{{/each}}</ul>
            {{#if editable}}<button type="button" class="btn peq" data-action="divindade-poderes">{{localize "ICARUS.Devocao.BotaoPoderes"}}</button>{{/if}}
          </div>
        </details>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="nivel">
    <div class="nivel-linha">
      {{#if editable}}<button type="button" class="btn quad" data-action="nivel" data-delta="-1" aria-label="{{localize 'ICARUS.Nivel.Diminuir'}}">−</button>{{/if}}
      <div>
        <div class="nivel-rot">{{localize "ICARUS.Nivel.Rotulo"}}</div>
        <div class="nivel-num">{{nivel.valor}}</div>
      </div>
      {{#if editable}}<button type="button" class="btn quad" data-action="nivel" data-delta="1" aria-label="{{localize 'ICARUS.Nivel.Aumentar'}}">+</button>{{/if}}
    </div>
    <div class="pips" role="img" aria-label="{{localize 'ICARUS.Nivel.Rotulo'}} {{nivel.valor}} / 25">
      {{#each nivel.pips}}<span class="pip {{classe}}"></span>{{/each}}
    </div>
    {{#if nivel.paragon}}
    <div class="paragon">{{localize "ICARUS.Nivel.Paragon"}}</div>
    {{else}}
    <div class="paragon-dica">{{localize "ICARUS.Nivel.ParagonDica"}}</div>
    {{/if}}
  </div>
</header>
