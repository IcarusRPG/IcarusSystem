<div class="poderes">
  {{#each gruposPoder}}
  <section class="grupo">
    <div class="grupo-cab">
      {{#if icone}}
      <span class="hex-mini grupo-icone" aria-hidden="true"><span class="moldura hex"></span><span class="miolo hex"><img src="{{icone}}" alt="" onerror="this.onerror=null;this.src='{{@root.iconePadrao}}'"></span></span>
      {{else}}<span class="losango"></span>{{/if}}
      <h3>{{titulo}}</h3>
      <span class="fio"></span>
      <span class="tag">{{tag}}</span>
      {{#if @root.editable}}
      {{#if ehRaca}}{{#if @root.raca.temEscolhas}}
      <button type="button" class="btn peq{{#if @root.raca.pendente}} ativo pendente{{else}} tracejado{{/if}}" data-action="raca-escolhas">
        {{#if @root.raca.pendente}}{{localize "ICARUS.Racas.EscolhasPendentes"}}{{else}}{{localize "ICARUS.Racas.Escolhas.Botao"}}{{/if}}
      </button>
      {{/if}}{{/if}}
      <button type="button" class="btn peq tracejado" data-action="item-criar" data-tipo="poder" data-fonte="{{fonte}}">{{localize "ICARUS.Poderes.Adicionar"}}</button>
      {{/if}}
    </div>
    <div class="cards">
      {{#each poderes}}
      <article class="painel card{{#if mostrarIcone}} com-icone{{/if}}" data-item-id="{{id}}" data-abrir-item>
        {{#if mostrarIcone}}
        <span class="hex-mini card-icone" aria-hidden="true"><span class="moldura hex"></span><span class="miolo hex"><img src="{{img}}" alt="" onerror="this.onerror=null;this.src='{{@root.iconePadrao}}'"></span></span>
        {{/if}}
        <div class="card-corpo">
          <div class="card-topo">
            <b>{{name}}</b>
            {{#if custo}}<span class="custo">{{custo}} PM</span>{{/if}}
          </div>
          {{#if concedido}}<div class="card-tags"><span class="tag-racial">{{localize "ICARUS.Devocao.TagConcedido"}}</span></div>{{/if}}
          {{#if auto}}<div class="card-tags"><span class="tag-racial">{{localize "ICARUS.Racas.TagRacial"}}</span>{{#if pendente}}<span class="tag-pendente">{{localize "ICARUS.Racas.EscolhaPendente"}}</span>{{/if}}</div>{{/if}}
          {{#if meta}}<div class="card-meta">{{meta}}</div>{{/if}}
          <div class="card-texto">{{{descricao}}}</div>
          <div class="card-acoes">
            {{#if escolhaPendente}}<button type="button" class="btn peq ativo pendente" data-action="poder-escolha">{{localize "ICARUS.Escolhas.Concluir"}}</button>{{/if}}
            {{#if escolhaAlteravel}}<button type="button" class="btn peq tracejado" data-action="poder-escolha">{{localize "ICARUS.Escolhas.Alterar"}}</button>{{/if}}
            {{#if usavel}}<button type="button" class="btn peq" data-action="poder-usar" data-tooltip="{{usarDica}}"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> {{localize "ICARUS.Poderes.Usar"}}</button>{{/if}}
            <button type="button" class="btn icone" data-action="poder-chat" aria-label="{{localize 'ICARUS.Poderes.EnviarChat'}} {{name}}" title="{{localize 'ICARUS.Poderes.EnviarChat'}}"><i class="fa-solid fa-comment" aria-hidden="true"></i></button>
          {{#if @root.editable}}
            {{#if pendente}}<button type="button" class="btn peq ativo" data-action="raca-escolhas">{{localize "ICARUS.Racas.FazerEscolha"}}</button>{{/if}}
            <button type="button" class="btn icone" data-action="item-editar" aria-label="{{localize 'ICARUS.Acoes.Editar'}} {{name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
            <button type="button" class="btn icone" data-action="item-excluir" aria-label="{{localize 'ICARUS.Acoes.Excluir'}} {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
          {{/if}}
          </div>
        </div>
      </article>
      {{else}}
      <div class="card-vazio">{{vazio}}</div>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
