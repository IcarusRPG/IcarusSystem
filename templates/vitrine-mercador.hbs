<div class="ficha-icarus vitrine-corpo">
  <figure class="vm-retrato">
    <img src="{{img}}" alt="{{nome}}">
  </figure>

  <div class="vm-conteudo">
    <header class="vm-cabecalho">
      <h1 class="vm-nome">{{nome}}</h1>
      {{#if balao.texto}}
      <blockquote class="vm-balao {{#if balao.forte}}forte{{/if}}" data-chave="{{balao.chave}}">
        <p>{{balao.texto}}</p>
      </blockquote>
      {{/if}}
      {{#if testes.length}}
      <div class="vm-testes">
        {{#each testes}}
        <button type="button" class="vm-teste {{#if feito}}feito {{#if passou}}passou{{else}}falhou{{/if}}{{/if}}" data-action="barganha" data-teste="{{chave}}" {{#if desativado}}disabled{{/if}}>
          <span><i class="fa-solid fa-dice-d20"></i> {{nome}}{{#if feito}} <span class="vm-marca">{{#if passou}}✓{{else}}✗{{/if}}</span>{{/if}}</span>
          {{#if legenda}}<small>{{legenda}}</small>{{/if}}
        </button>
        {{/each}}
      </div>
      {{#if semMestre}}<p class="vm-aviso">{{localize "ICARUS.Loja.SemMestre"}}</p>{{/if}}
      {{/if}}
    </header>

    {{#if guardas}}<p class="vm-fechada vm-guardas"><i class="fa-solid fa-shield-halved"></i> {{localize "ICARUS.Loja.Barganha.Guardas"}}</p>
    {{else}}{{#unless aberta}}<p class="vm-fechada"><i class="fa-solid fa-door-closed"></i> {{localize "ICARUS.Loja.Fechada"}}</p>{{/unless}}{{/if}}
    {{#if (or desconto acrescimo)}}<p class="vm-ajustes">{{#if desconto}}<span class="vm-desconto">−{{desconto}}%</span>{{/if}} {{#if acrescimo}}<span class="vm-acrescimo">+{{acrescimo}}%</span>{{/if}}</p>{{/if}}

    {{#if podeVender}}
    <nav class="fm-abas vm-abas">
      <a class="{{#if (eq aba "comprar")}}ativa{{/if}}" data-action="aba" data-aba="comprar">{{localize "ICARUS.Loja.AbaComprar"}}</a>
      <a class="{{#if (eq aba "vender")}}ativa{{/if}}" data-action="aba" data-aba="vender">{{localize "ICARUS.Loja.AbaVender"}}</a>
    </nav>
    {{/if}}

    <div class="vm-lista">
      {{#if (eq aba "vender")}}
      <table class="vm-tabela">
        <thead><tr><th></th><th>{{localize "ICARUS.Mercador.Item"}}</th><th>{{localize "ICARUS.Loja.Tem"}}</th><th>{{localize "ICARUS.Loja.PagaPor"}}</th><th></th></tr></thead>
        <tbody>
          {{#each venda}}
          <tr data-item-id="{{id}}">
            <td><img src="{{img}}" alt="" width="40" height="40"></td>
            <td>{{nome}}</td>
            <td>{{tem}}</td>
            <td>{{preco}}</td>
            <td class="vm-acao"><input type="number" data-quantidade value="1" min="1" max="{{tem}}" step="1">
              <button type="button" class="btn" data-action="vender" {{#if desativado}}disabled{{/if}}>{{localize "ICARUS.Loja.Vender"}}</button></td>
          </tr>
          {{else}}<tr><td colspan="5" class="dica">{{localize "ICARUS.Loja.NadaParaVender"}}</td></tr>{{/each}}
        </tbody>
      </table>
      {{else}}
      <table class="vm-tabela">
        <thead><tr><th></th><th>{{localize "ICARUS.Mercador.Item"}}</th><th>{{localize "ICARUS.Loja.Estoque"}}</th><th>{{localize "ICARUS.Loja.Preco"}}</th><th></th></tr></thead>
        <tbody>
          {{#each itens}}
          <tr data-item-id="{{id}}" class="{{#if esgotado}}esgotado{{/if}}">
            <td><img src="{{img}}" alt="" width="40" height="40"></td>
            <td title="{{dica}}">{{nome}}{{#if liberado}} <i class="fa-solid fa-key vm-liberado" data-tooltip="{{localize "ICARUS.Loja.Barganha.Liberado"}}"></i>{{/if}}</td>
            <td>{{#if esgotado}}{{localize "ICARUS.Loja.Esgotado"}}{{else}}{{estoque}}{{/if}}</td>
            <td class="vm-preco" title="{{precoOuro}}">{{preco}}</td>
            <td class="vm-acao"><input type="number" data-quantidade value="1" min="1" max="{{max}}" step="1" {{#if desativado}}disabled{{/if}}>
              <button type="button" class="btn primario" data-action="comprar" {{#if desativado}}disabled{{/if}}>{{localize "ICARUS.Loja.Comprar"}}</button>
              {{#if ../podeRoubar}}<button type="button" class="btn vm-roubar" data-action="roubar" {{#if roubarDesativado}}disabled{{/if}} data-tooltip="{{localize "ICARUS.Loja.Roubo.Dica"}}"><i class="fa-solid fa-hand"></i> {{localize "ICARUS.Loja.Roubo.Roubar"}}</button>{{/if}}</td>
          </tr>
          {{else}}<tr><td colspan="5" class="dica">{{localize "ICARUS.Loja.NadaAVenda"}}</td></tr>{{/each}}
        </tbody>
      </table>
      {{/if}}
    </div>

    <footer class="vm-rodape">
      {{#if semComprador}}
      <p class="aviso">{{localize "ICARUS.Loja.SemComprador"}}</p>
      {{else}}
      <div class="vm-comprador">
        <span class="vm-rotulo">{{localize "ICARUS.Loja.Comprador"}}</span>
        {{#if (gt compradores.length 1)}}
        <select data-comprador aria-label="{{localize "ICARUS.Loja.QuemCompra"}}">{{#each compradores}}<option value="{{uuid}}" {{#if selecionado}}selected{{/if}}>{{nome}}</option>{{/each}}</select>
        {{else}}<strong>{{comprador}}</strong>{{/if}}
      </div>
      <div class="vm-dinheiro"><span class="vm-rotulo">{{localize "ICARUS.Loja.SeuDinheiro"}}</span> <strong>{{saldo}}</strong></div>
      {{/if}}
    </footer>
  </div>
</div>
